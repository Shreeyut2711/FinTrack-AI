{
  "name": "fintrack-ai-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "pnpm --filter fintrack-frontend dev",
    "dev:backend": "pnpm --filter fintrack-backend dev",
    "dev:ai": "python ai-service/main.py",
    "build:frontend": "pnpm --filter fintrack-frontend build",
    "build:backend": "pnpm --filter fintrack-backend build",
    "build": "pnpm build:backend && pnpm build:frontend"
  }
}
