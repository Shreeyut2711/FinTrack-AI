# FinTrack AI Environment Configuration Example
# Copy to .env in backend and ai-service for production setup

# Node Backend
PORT=3001
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/fintrack?retryWrites=true&w=majority
AI_SERVICE_URL=http://localhost:5000

# Python AI Service
AI_SERVICE_PORT=5000
OPENAI_API_KEY=your_openai_api_key_optional
GEMINI_API_KEY=your_gemini_api_key_optional
OCR_API_KEY=your_ocr_api_key_optional

# Frontend
VITE_API_URL=/api
